Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"loadCent", "[", 
    RowBox[{"cent_String", ",", 
     RowBox[{"particle_String", ":", "particle"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "pAraw", ",", "ppraw", ",", "RpAraw", ",", "pAlog", ",", "pAerrlog", 
       ",", "pblog", ",", "rp", ",", "rperr", ",", "yb", ",", "ptb"}], "}"}], 
     ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"!", 
            RowBox[{"FileExistsQ", "/@", 
             RowBox[{"centFile", "[", 
              RowBox[{"cent", ",", "particle", ",", "#"}], "]"}]}]}], "&"}], "/@", 
          RowBox[{"{", 
           RowBox[{"\"\<pA\>\"", ",", "\"\<pp\>\"", ",", "\"\<RpA\>\""}], 
           "}"}]}], "//", 
         RowBox[{
          RowBox[{"And", "@@", "#"}], "&"}]}], ",", 
        RowBox[{
         RowBox[{"MessageDialog", "[", 
          RowBox[{
          "\"\<Missing one or more files for centrality: \>\"", "<>", 
           "cent"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Return", "[", "$Failed", "]"}], ";"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pAraw", "=", 
       RowBox[{"Import", "[", 
        RowBox[{"centFile", "[", 
         RowBox[{"cent", ",", "particle", ",", "\"\<pA\>\""}], "]"}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"ppraw", "=", 
       RowBox[{"Import", "[", 
        RowBox[{"centFile", "[", 
         RowBox[{"cent", ",", "particle", ",", "\"\<pp\>\""}], "]"}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"RpAraw", "=", 
       RowBox[{"Import", "[", 
        RowBox[{"centFile", "[", 
         RowBox[{"cent", ",", "particle", ",", "\"\<RpA\>\""}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "exact", " ", "same", " ", "transforms", " ", "you", " ", "already", 
        " ", "use"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"pAlog", "=", 
       RowBox[{"Interpolation", "[", 
        RowBox[{
         RowBox[{"myLog", "/@", 
          RowBox[{"pAraw", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "]"}], "]"}]}], ",", 
         RowBox[{"InterpolationOrder", "->", "Automatic"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
