        RowBox[{
         RowBox[{"myLog", "/@", 
          RowBox[{"pAraw", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "2", ",", "4"}], "}"}]}], "]"}], "]"}]}], ",", 
         RowBox[{"InterpolationOrder", "->", "Automatic"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pblog", "=", 
       RowBox[{"Interpolation", "[", 
        RowBox[{
         RowBox[{"myLog", "/@", "ppraw"}], ",", 
         RowBox[{"InterpolationOrder", "->", "Automatic"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rp", "=", 
       RowBox[{"Interpolation", "[", 
        RowBox[{
         RowBox[{"RpAraw", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "]"}], "]"}], ",", 
         RowBox[{"InterpolationOrder", "->", "Automatic"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rperr", "=", 
       RowBox[{"Interpolation", "[", 
        RowBox[{
         RowBox[{"RpAraw", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "2", ",", "4"}], "}"}]}], "]"}], "]"}], ",", 
         RowBox[{"InterpolationOrder", "->", "Automatic"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"yb", ",", "ptb"}], "}"}], "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"rp", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
         RowBox[{"rp", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "}"}]}], ";", 
      RowBox[{"(*", 
